{
    "name": "magpern/universal-multicurrency",
    "description": "Universal multicurrency for WooCommerce. Currency affects monetary values only; WooCommerce owns products and inventory.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-phpunit/wp-phpunit": "^6.5 || ^7.0",
        "wp-coding-standards/wpcs": "^3.1",
        "woocommerce/woocommerce-sniffs": "^1.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "UMC\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UMC\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test:unit": "phpunit -c phpunit.xml.dist",
        "test:integration": "phpunit -c phpunit-integration.xml.dist"
    },
    "config": {
        "platform": {
            "php": "8.1.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
