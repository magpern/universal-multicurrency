# Copy to .env (gitignored, never commit) or export these directly in your
# shell / CI secret store before running the M25 browser acceptance suite.
# See README.md for the full contract, including the hard production-host
# guard these values are checked against.

UMC_E2E_BASE_URL=https://your-dev-site.example
UMC_E2E_ADMIN_USER=
UMC_E2E_ADMIN_PASSWORD=

# Optional: comma-separated hostname allowlist. Defaults to "dev.biopentra.eu"
# if unset -- see fixtures/production-guard.ts. The suite refuses to run
# against any host not on this list; there is no way to disable the guard.
# UMC_E2E_ALLOWED_HOSTS=dev.biopentra.eu

# Optional: fix the fixture-product run id for a reproducible/debuggable
# run instead of a fresh timestamp-based one each time.
# UMC_E2E_RUN_ID=
