<?xml version="1.0"?>
<ruleset name="UniversalMulticurrency">
	<description>Coding standards for the Universal Multicurrency plugin.</description>

	<file>universal-multicurrency.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/tmp/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 class files (src/Plugin.php) instead of class-plugin.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WooCommerce-Core">
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="universal-multicurrency"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="umc"/>
				<element value="UMC"/>
			</property>
		</properties>
		<!-- "umc"/"UMC" is the project-approved prefix (docs/); accepted despite being under 4 chars. -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
	</rule>

	<!-- Test method names are self-describing; don't demand full docblocks
	     there. Data-provider annotations still require a docblock, so relax the
	     short-description and param-tag requirements for test files only. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Test files legitimately override globals and load files dynamically. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Structural tests read local source files directly. -->
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- The pure-domain layer (value objects, converter, rate providers and
	     their exceptions) contains no HTML output and must run without
	     WordPress loaded, so esc_html() is unavailable there. Exception
	     messages built in these files are developer diagnostics, never echoed
	     to the browser. This exclusion does NOT apply to output-producing code
	     (admin/frontend), which arrives in later milestones. -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>*src/Currency.php</exclude-pattern>
		<exclude-pattern>*src/Converter.php</exclude-pattern>
		<exclude-pattern>*src/Rates/*</exclude-pattern>
		<exclude-pattern>*src/Exceptions/*</exclude-pattern>
	</rule>
</ruleset>
